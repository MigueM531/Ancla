# Puerto en el que se ejecuta el servidor web
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=development

# Clave secreta para firmar los tokens JWT de sesión
JWT_SECRET=ancla_udemellin_secret_key_2026_permanencia

# Cadena de conexión a PostgreSQL en Neon (neon.tech)
# Obtén tu URL en la consola de Neon: Dashboard -> Project -> Connection Details -> URI
# Ejemplo:
# DATABASE_URL=postgresql://neondb_owner:tu_password_aqui@ep-xyz-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
